# Mẫu file env cho runtime API trên GreenNode AgentBase (dùng với runtime.sh --env-file).
# CÁCH DÙNG: sao chép thành deploy/runtime-api.env (đã bị .gitignore/.dockerignore chặn),
# điền giá trị thật NGOÀI phiên làm việc với AI, rồi chỉ đưa ĐƯỜNG DẪN file cho skill.
#   cp deploy/runtime-api.env.example deploy/runtime-api.env
#
# KHÔNG đặt GREENNODE_CLIENT_ID / GREENNODE_CLIENT_SECRET / GREENNODE_AGENT_IDENTITY /
# GREENNODE_ENDPOINT_URL ở đây — nền tảng tự tiêm vào container.
# KHÔNG đặt PORT: Dockerfile.api đã cố định cổng 8080 theo yêu cầu của nền tảng.

# ---- AI runtime (GreenNode MaaS, OpenAI-compatible; base URL kết thúc bằng /v1) ----
AI_BASE_URL=https://<host-maas>/v1
AI_API_KEY=<api-key-maas>
AI_MODEL=<ten-model>
# Hạn mức request/phút theo từng model (GreenNode đặt riêng từng model, vượt là 429). Dạng: model=số,model=số.
# Hệ thống tự CHỜ (delay) để không vượt hạn mức, và header x-ratelimit-limit-minute của API (nếu có) ghi đè số này.
# Ví dụ đo được ngày 2026-09-20: qwen 2, glm-5.3-flash 5, glm-5.2-hackathon 5. Để trống = chỉ dựa vào header/429.
AI_MODEL_LIMITS=qwen/qwen3.6-flash=2,z-ai/glm-5.3-flash-thirdparty=5,google/gemma-4-31b-it=10
# AI_DEBUG_* để trống = dùng chung AI_* ở trên
AI_DEBUG_BASE_URL=
AI_DEBUG_API_KEY=
AI_DEBUG_MODEL=

# ---- Database crawl: BẮT BUỘC dùng Postgres khi deploy (SQLite trong container mất khi restart) ----
DB_BACKEND=postgres
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>

# ---- Runner / Automation (tài khoản admin dùng chung cho Crawl + Automation) ----
RUNNER_ENABLED=true
RUNNER_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>
RUNNER_DATA_ROOT=/app/data/runner
RUNNER_AI_ENABLED=false
# Model riêng cho Runner Describe (để trống = dùng chung AI_MODEL)
RUNNER_AI_MODEL=

# ---- Admin dự phòng (HTTP Basic, chỉ mở phần Crawl). Để trống nếu chỉ dùng admin Runner ----
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Fetch / tuân thủ ----
FETCH_ENGINE=playwright
FETCH_USER_AGENT=web-extract-agent/0.1
FETCH_DEFAULT_DELAY_SECONDS=2
FETCH_RESPECT_ROBOTS_TXT=true

LOG_LEVEL=INFO
