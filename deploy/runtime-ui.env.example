# Mẫu file env cho runtime UI (Streamlit + nginx) trên GreenNode AgentBase.
# CÁCH DÙNG: cp deploy/runtime-ui.env.example deploy/runtime-ui.env  rồi điền.
# UI không cần AI key hay database — chỉ cần biết địa chỉ API.
#
# Triển khai runtime API TRƯỚC, lấy endpoint của nó (skill in ra sau khi ACTIVE),
# rồi điền vào đây và mới tạo runtime UI.

API_BASE_URL=https://<endpoint-runtime-api>
