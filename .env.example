# ===== AI runtime (Qwen/GLM do BTC/GreenNode cấp — KHÔNG liên quan đến dev tool đang dùng để code) =====
AI_BASE_URL=https://your-greennode-endpoint.example/v1
AI_API_KEY=
AI_MODEL=qwen-3.6-flash
AI_TIMEOUT_SECONDS=30
AI_CONFIDENCE_THRESHOLD=0.7

# Model "debug assistant" cho panel admin (gợi ý sửa lỗi) — KHÔNG dùng trong
# pipeline crawl/extract. Mặc định dùng chung AI_BASE_URL/AI_API_KEY ở trên,
# chỉ cần điền AI_DEBUG_MODEL nếu GLM khác model đang dùng cho extract.
# Để trống AI_DEBUG_BASE_URL/AI_DEBUG_API_KEY nếu dùng chung endpoint/key.
AI_DEBUG_MODEL=
AI_DEBUG_BASE_URL=
AI_DEBUG_API_KEY=
AI_DEBUG_TIMEOUT_SECONDS=30


# ===== Scraping =====
FETCH_USER_AGENT=web-extract-agent/0.1 (+contact: your-email@example.com)
FETCH_DEFAULT_DELAY_SECONDS=2
FETCH_RESPECT_ROBOTS_TXT=true
PLAYWRIGHT_HEADLESS=true

# ===== Storage =====
DB_PATH=./data/app.db

# ===== App =====
API_PORT=8000
LOG_LEVEL=INFO
