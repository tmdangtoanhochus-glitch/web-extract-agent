def test_file_crawl_overwrite_row_replaces_by_key_field(tmp_path):
    fetcher = _FakeFetcher(default_html="<html><body><p>giá 75.000.000</p></body></html>")
    ai_client = _FakeAIClient([_extraction(price_value=1), _extraction(price_value=2)])
    storage = _storage()
    kwargs = dict(
        url="https://example.com/gold",
        field_descriptions={"price": "giá vàng", "date": "ngày cập nhật"},
        file_path="gold.json",
        write_mode="overwrite_row",
        key_field="date",
        fetcher=fetcher,
        ai_client=ai_client,
        storage=storage,
        exports_root=tmp_path,
    )

    run_file_crawl_job(**kwargs)
    run_file_crawl_job(**kwargs)

    written = json.loads((tmp_path / "gold.json").read_text(encoding="utf-8"))
    assert len(written) == 1  # cùng date -> ghi đè, không thêm dòng mới
    assert written[0]["data"]["price"] == 2


def test_file_crawl_reuses_extraction_strategy_cache_across_file_and_db_flows(tmp_path):
    """Cache chiến lược theo domain (CLAUDE.md mục 5) dùng chung `storage` cho
    cả 2 luồng — AI định vị field ở luồng DB thì luồng file cùng domain sau đó
    tận dụng lại được, không cần gọi AI riêng."""
    html = "<html><body><div><span>SJC 1L</span><span>79.900.000</span></div></body></html>"
    storage = _storage()
    ai_client = _FakeAIClient(
        [ExtractionResult(fields={"price": FieldExtraction(value="79.900.000", confidence=0.9, evidence="e")}, success=True)]
    )

    run_crawl_job(
        url="https://example.com/db-page",
        field_descriptions={"price": "giá bán"},
        dataset_name="Giá vàng",
        fetcher=_FakeFetcher(default_html=html),
        ai_client=ai_client,
        storage=storage,
    )
    assert ai_client.calls == 1

    file_result = run_file_crawl_job(
        url="https://example.com/file-page",
        field_descriptions={"price": "giá bán"},
        file_path="gold.json",
        write_mode="append",
        fetcher=_FakeFetcher(default_html=html),
        ai_client=ai_client,
        storage=storage,
        exports_root=tmp_path,
    )

    assert file_result.status == "saved"
    assert ai_client.calls == 1  # vẫn 1 — luồng file tận dụng cache, không gọi AI lại


# ---- image_fields (tải ảnh về, thay giá trị field bằng đường dẫn local) -----
def test_image_fields_downloads_and_replaces_value_with_local_path(monkeypatch):
    """`image_fields` là field người dùng khai báo tường minh là ảnh — sau khi
    AI trả về URL, code (rule-based) tải file về và thay giá trị field bằng
    đường dẫn local, KHÔNG phải AI tự quyết định việc này (CLAUDE.md mục 1)."""
    from src.storage.image_downloader import ImageDownloadResult

    def fake_download_image(url, record_key, field_name, images_root, **kwargs):
        assert url == "https://example.com/photo.jpg"
        return ImageDownloadResult(success=True, local_path="ds_anh_abc123.jpg")

    monkeypatch.setattr("src.pipeline.download_image", fake_download_image)

    fetcher = _FakeFetcher(default_html="<html><body><p>a</p></body></html>")
    ai_client = _FakeAIClient(
        [
            ExtractionResult(
                fields={"anh": FieldExtraction(value="https://example.com/photo.jpg", confidence=0.9, evidence="e")},
                success=True,
            )
        ]
    )
    storage = _storage()

    result = run_crawl_job(
        url="https://example.com/bds",
        field_descriptions={"anh": "ảnh tài sản"},
        dataset_name="Bất động sản",
        fetcher=fetcher,
        ai_client=ai_client,
        storage=storage,
        image_fields=["anh"],
    )

    assert result.record.data["anh"] == "ds_anh_abc123.jpg"


def test_image_fields_download_failure_keeps_original_url_and_does_not_block_record(monkeypatch):
    """1 ảnh tải lỗi KHÔNG được chặn cả record — giữ nguyên URL gốc để không
    mất thông tin, chỉ ghi log cảnh báo."""
    from src.storage.image_downloader import ImageDownloadResult

    def fake_download_image(url, record_key, field_name, images_root, **kwargs):
        return ImageDownloadResult(success=False, error="Content-Type không phải ảnh: text/html")

    monkeypatch.setattr("src.pipeline.download_image", fake_download_image)

    fetcher = _FakeFetcher(default_html="<html><body><p>a</p></body></html>")
    ai_client = _FakeAIClient(
        [
            ExtractionResult(
                fields={"anh": FieldExtraction(value="https://example.com/broken.jpg", confidence=0.9, evidence="e")},
                success=True,
            )
        ]
    )
    storage = _storage()

    result = run_crawl_job(
        url="https://example.com/bds",
        field_descriptions={"anh": "ảnh tài sản"},
        dataset_name="Bất động sản",
        fetcher=fetcher,
        ai_client=ai_client,
        storage=storage,
        image_fields=["anh"],
    )

    assert result.status == "saved"
    assert result.record.data["anh"] == "https://example.com/broken.jpg"


def test_image_fields_only_affects_fields_explicitly_listed():
    """Field không nằm trong `image_fields` giữ nguyên giá trị AI trả về,
    không bị đụng tới — người dùng phải khai báo tường minh field nào là ảnh."""
    fetcher = _FakeFetcher(default_html="<html><body><p>a</p></body></html>")
    ai_client = _FakeAIClient([_extraction()])
    storage = _storage()

    result = run_crawl_job(
        url="https://example.com/gold",
        field_descriptions={"price": "giá vàng", "date": "ngày cập nhật"},
        dataset_name="Giá vàng SJC",
        fetcher=fetcher,
        ai_client=ai_client,
        storage=storage,
        image_fields=[],
    )

    assert result.record.data == {"price": 75000000, "date": "2026-09-11"}
